# ==============================================================================
# CONFIGURATION ENVIRONNEMENT — PLATEFORME SAAS D'ASSISTANCE COMPTABLE
# ==============================================================================
# Copiez ce fichier vers `.env` et adaptez les valeurs à votre environnement.
# Aucun secret réel ne doit jamais être commité dans le dépôt.

# Identité configurable du produit (aucun nom en dur dispersé dans le code)
APP_NAME="ComptaNova"
APP_TAGLINE="Plateforme d'assistance comptable intelligente, multi-tenant et multi-pays"
APP_SUPPORT_EMAIL="support@comptanova.example.com"
APP_LEGAL_ENTITY="ComptaNova SAS (Configuration Démo)"

# Serveur HTTP & Environnement
NODE_ENV="development"
PORT=3000
HOST="127.0.0.1"

# Base de données
# En développement/test local autonome : SQLite embarqué (node:sqlite)
# En production : PostgreSQL (postgresql://user:password@localhost:5432/comptanova)
DATABASE_ENGINE="sqlite"
DATABASE_PATH="./data/app.db"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/comptanova"

# Sécurité & Sessions
# Générer avec : openssl rand -hex 32
SESSION_SECRET="remplacer-par-une-cle-secrete-aleatoire-de-64-caracteres-minimum"
SESSION_TTL_HOURS=24
SIGNED_URL_SECRET="remplacer-par-une-cle-secrete-pour-liens-temporaires-documents"
SIGNED_URL_TTL_SECONDS=300

# Stockage documentaire privé (local ou compatible S3)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/private-documents"
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="eu-west-3"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Fournisseurs IA (Abstraction hybride — désactivable)
AI_ENABLED="true"
AI_DEFAULT_PROVIDER="mock-deterministic"
AI_MAX_COST_CENTS_PER_ORG_MONTH=5000
AI_REQUEST_TIMEOUT_MS=15000
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Pays par défaut à l'initialisation
DEFAULT_COUNTRY_CODE="FR"
